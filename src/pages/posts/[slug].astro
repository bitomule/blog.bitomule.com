---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, postSlug, tagSlug } from '@/lib/posts';
import { postAliases } from '@/data/postAliases';

export async function getStaticPaths() {
  const posts = await getPosts();
  const canonical = posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post, target: null } }));
  const aliases = Object.entries(postAliases).map(([alias, target]) => ({ params: { slug: alias }, props: { post: null, target } }));
  return [...canonical, ...aliases];
}

const { post, target } = Astro.props;
if (target) {
  Astro.response.headers.set('Location', `/posts/${target}/`);
  Astro.response.status = 301;
}
const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
---
{target ? (
  <BaseLayout title="Moved" description="This post has moved.">
    <meta http-equiv="refresh" content={`0; url=/posts/${target}/`} />
    <link rel="canonical" href={`/posts/${target}/`} />
    <div class="redirect-box">
      <h1>Moved</h1>
      <p>This post now lives at <a href={`/posts/${target}/`}>/posts/{target}/</a>.</p>
    </div>
  </BaseLayout>
) : (
  <BaseLayout title={post.data.title} description={post.data.excerpt}>
    <article>
      <header class="post-header">
        <p class="meta">{formatDate(post.data.date)}</p>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.excerpt}</p>
        <div class="tags" aria-label="Tags">
          {post.data.tags.map((tag) => <a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}
        </div>
      </header>
      <div class="prose">
        {Content && <Content />}
      </div>
    </article>
  </BaseLayout>
)}
